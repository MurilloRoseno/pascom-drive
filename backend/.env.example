# Node Environment
PORT=3001
NODE_ENV=development

# Mercado Pago (Sandbox for dev, Production for prod)
MP_ACCESS_TOKEN=TEST-<sua-access-token-sandbox>
MP_WEBHOOK_SECRET=<seu-webhook-secret-sandbox>

# Google Sheets API
SPREADSHEET_ID=<google-sheet-id-dev>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account@project.iam.gserviceaccount.com>
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Google Drive Folders
SOURCE_FOLDER_ID=<folder-id-source>
ORIGINAIS_FOLDER_ID=<folder-id-originais>
AMOSTRAS_FOLDER_ID=<folder-id-amostras>

# Admin Email (for error notifications)
ADMIN_EMAIL=murillo.roseno.lima@gmail.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
