# Node Environment
PORT=3001
NODE_ENV=development

# Mercado Pago (Sandbox for dev, Production for prod)
MP_ACCESS_TOKEN=TEST-<sua-access-token-sandbox>
MP_WEBHOOK_SECRET=<seu-webhook-secret-sandbox>
MP_USE_SANDBOX=true
PUBLIC_APP_URL=http://localhost:3000
DOWNLOAD_JWT_SECRET=<segredo-aleatorio-para-links-de-download>
GALLERY_SESSION_SECRET=<segredo-aleatorio-para-acesso-de-galerias>
GALLERY_CODE_SALT=<salt-privado-compartilhado-com-apps-script>
CACHE_INVALIDATION_SECRET=<segredo-aleatorio-compartilhado-com-apps-script>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=murillo.roseno.lima@gmail.com
SMTP_APP_PASSWORD=<senha-de-app-do-gmail-sem-espacos>
SMTP_FROM_NAME=Paroquia Sao Rafael - Fotos
SMTP_REPLY_TO=murillo.roseno.lima@gmail.com

# Google Sheets API
SPREADSHEET_ID=<google-sheet-id-dev>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account@project.iam.gserviceaccount.com>
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Opcionalmente, use GOOGLE_PRIVATE_KEY_B64=<chave-em-base64> no lugar da linha acima.

# Google Drive Folders
SOURCE_FOLDER_ID=<folder-id-source>
ORIGINAIS_FOLDER_ID=<folder-id-originais>
AMOSTRAS_FOLDER_ID=<folder-id-amostras>

# Admin Email (for error notifications)
ADMIN_EMAIL=murillo.roseno.lima@gmail.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Painel da equipe (login Clerk). Chaves de teste em dashboard.clerk.com > API keys.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Origens do frontend que podem usar a sessão (separadas por vírgula)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# E-mail que entra sempre como admin, mesmo com a aba EquipePascom vazia (primeiro acesso)
PAINEL_ADMIN_EMAIL=
